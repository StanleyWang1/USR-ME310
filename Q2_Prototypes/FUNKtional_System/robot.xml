<mujoco model="SphereWithSlidersAndActuators">
    <visual>
        <map force="0.1" zfar="30"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global offwidth="2560" offheight="1440" elevation="-20" azimuth="120"/>
    </visual>

    <option timestep="0.001"/>
    <option gravity="0 0 -30"/>

    <statistic center="0 0 0.7"/>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="32" height="512"/>
        <texture name="body" type="cube" builtin="flat" mark="cross" width="128" height="128" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" markrgb="1 1 1"/>
        <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
        <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance="0"/>
    
        <mesh name="base_mesh" file="meshes/base.stl"/>
        <mesh name="left_mesh" file="meshes/left.stl"/>
        <mesh name="right_mesh" file="meshes/right.stl"/>
    </asset>

    <worldbody>
        <!-- Ground plane -->
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="grid" contype="5" condim="3"/>
        
        <!-- Directional light source -->
        <light directional="true" pos="0 0 5" dir="0 0 -1"/>

        <!-- Sphere with slider joints -->
        <body name="sphere1" pos="0 0 0">
            <!-- Slider joints for x, y, z movement -->
            <joint name="slider1_x" type="slide" axis="1 0 0" damping="10"/>
            <joint name="slider1_y" type="slide" axis="0 1 0" damping="10"/>
            <joint name="slider1_z" type="slide" axis="0 0 1" damping="10"/>
            <geom name="sphere1_geom" type="sphere" size="0.0075" rgba="1 0 0 1" friction="10 1 1" contype="1" condim="3" solref=".005 1"/>
            <site name="site_sphere1" pos="0 0 0" size="0.001" type="sphere" rgba="1 1 1 1"/>
             
            <body name="ball_body" pos="0 0 0">
                <joint name="ball_joint" type="ball" pos="0 0 0"/>
                <geom type="mesh" mesh="base_mesh" pos="0 0 0" rgba="1 0.2 0.2 1"/>
                <body name="left_jaw" pos="0 0 0">
                    <joint name="left_jaw_pin" type="hinge" axis="0 0 1"/>
                    <geom type="mesh" mesh="left_mesh" pos="0 0 0" rgba="0.5 0.5 0.5 1"/>
                    <site name="left_jaw_site" pos="0 0.075 0" size="0.001" type="sphere" rgba="1 1 1 1"/>
                </body>
                <body name="right_jaw" pos="0 0 0">
                    <joint name="right_jaw_pin" type="hinge" axis="0 0 1"/>
                    <geom type="mesh" mesh="right_mesh" pos="0 0 0" rgba="0.5 0.5 0.5 1"/>
                    <site name="right_jaw_site" pos="0 0.075 0" size="0.001" type="sphere" rgba="1 1 1 1"/>
                </body>
            </body>
        </body>
        <body name="sphere2" pos="0 0 0">
            <!-- Slider joints for x, y, z movement -->
            <joint name="slider2_x" type="slide" axis="1 0 0" damping="10"/>
            <joint name="slider2_y" type="slide" axis="0 1 0" damping="10"/>
            <joint name="slider2_z" type="slide" axis="0 0 1" damping="10"/>
            <geom name="sphere2_geom" type="sphere" size="0.0075" rgba="1 0 0 1" friction="10 1 1" contype="1" condim="3" solref=".005 1"/>
            <site name="site_sphere2" pos="0 0 0" size="0.001" type="sphere" rgba="1 1 1 1"/>
        </body>
        <body name="sphere3" pos="0 0 0">
            <!-- Slider joints for x, y, z movement -->
            <joint name="slider3_x" type="slide" axis="1 0 0" damping="10"/>
            <joint name="slider3_y" type="slide" axis="0 1 0" damping="10"/>
            <joint name="slider3_z" type="slide" axis="0 0 1" damping="10"/>
            <geom name="sphere3_geom" type="sphere" size="0.0075" rgba="1 0 0 1" friction="10 1 1" contype="1" condim="3" solref=".005 1"/>
            <site name="site_sphere3" pos="0 0 0" size="0.001" type="sphere" rgba="1 1 1 1"/>
        </body>
        <body name="cube1" pos="0.04 0.0 0.5">
            <!-- Free joint allows full 6-DOF movement -->
            <freejoint name="free_cube_joint1"/>
            <!-- Cube geometry with green color -->
            <geom name="cube1" type="box" size="0.01 0.02 0.01" rgba="0 1 0 1" density="100" conaffinity="1"/>
        </body>
        <body name="cube2" pos="0.0 0.0 0.5">
            <!-- Free joint allows full 6-DOF movement -->
            <freejoint name="free_cube_joint2"/>
            <!-- Cube geometry with green color -->
            <geom name="cube2" type="box" size="0.01 0.02 0.01" rgba="1 1 0 1" density="100" conaffinity="1"/>
        </body>
        <body name="cube3" pos="-0.04 0.0 0.5">
            <!-- Free joint allows full 6-DOF movement -->
            <freejoint name="free_cube_joint3"/>
            <!-- Cube geometry with green color -->
            <geom name="cube3" type="box" size="0.01 0.02 0.01" rgba="0 1 1 1" density="100"conaffinity="1"/>
        </body>
    </worldbody>

    <actuator>
        <!-- Position actuators for each slider joint -->
        <position name="actuator1_x" joint="slider1_x" kp="1000"/>
        <position name="actuator1_y" joint="slider1_y" kp="1000"/>
        <position name="actuator1_z" joint="slider1_z" kp="1000"/>

        <position name="actuator2_x" joint="slider2_x" kp="1000"/>
        <position name="actuator2_y" joint="slider2_y" kp="1000"/>
        <position name="actuator2_z" joint="slider2_z" kp="1000"/>

        <position name="actuator3_x" joint="slider3_x" kp="1000"/>
        <position name="actuator3_y" joint="slider3_y" kp="1000"/>
        <position name="actuator3_z" joint="slider3_z" kp="1000"/>
    </actuator>

    <tendon>
        <spatial name="tendon1">
            <site site="site_sphere1"/>
            <site site="site_sphere2"/>
        </spatial>

        <spatial name="tendon2">
            <site site="site_sphere1"/>
            <site site="site_sphere3"/>
        </spatial>

        <spatial name="left_jaw_lock" springlength="0.01" stiffness="1000">
            <site site="site_sphere2"/>
            <site site="left_jaw_site"/>
        </spatial>
        <spatial name="right_jaw_lock" springlength="0.01" stiffness="1000">
            <site site="site_sphere3"/>
            <site site="right_jaw_site"/>
        </spatial>
    </tendon>
</mujoco>
